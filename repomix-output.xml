    max-height: 520px;
}
#cat-filter-drawer.is-open .cfd-body {
    flex: 1;
    overflow-y: auto;
    min-height: 0;
}
#cat-filter-drawer.is-open .cfd-footer {
    flex-shrink: 0;
}

#cat-grid { transition: none; }

#cat-panel { position: relative; }

.cfd-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px 14px;
    border-bottom: 1px solid #E8E3D9;
    flex-shrink: 0;
}
.cfd-title {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 1rem;
    font-weight: 800;
    color: #1A1714;
}
.cfd-close {
    background: none;
    border: none;
    color: #9C9589;
    font-size: 1rem;
    cursor: pointer;
    padding: 4px;
    border-radius: 6px;
    transition: color .15s, background .15s;
}
.cfd-close:hover { color: #1A1714; background: #F2EFE8; }

.cfd-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    scrollbar-width: thin;
    scrollbar-color: #E8E3D9 transparent;
}

.cfd-group-title {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #9C9589;
    margin-bottom: 10px;
}
.cfd-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
}
.cfd-chip {
    padding: 7px 13px;
    border-radius: 100px;
    border: 1.5px solid #E8E3D9;
    background: #fff;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: .8rem;
    font-weight: 500;
    color: #5C574F;
    cursor: pointer;
    transition: all .15s;
    white-space: nowrap;
}
.cfd-chip:hover {
    border-color: #1B3A5C;
    color: #1B3A5C;
}
.cfd-chip.is-selected {
    background: #1B3A5C;
    border-color: #1B3A5C;
    color: #fff;
    font-weight: 700;
}
.cfd-chip[hidden] { display: none !important; }

.cfd-footer {
    display: flex;
    gap: 8px;
    padding: 14px 16px;
    border-top: 1px solid #E8E3D9;
    flex-shrink: 0;
}
.cfd-reset {
    flex: 1;
    padding: 11px;
    border: 1.5px solid #E8E3D9;
    border-radius: 8px;
    background: #fff;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: .82rem;
    font-weight: 600;
    color: #5C574F;
    cursor: pointer;
    transition: all .15s;
}
.cfd-reset:hover { border-color: #E03040; color: #E03040; }
.cfd-apply {
    flex: 2;
    padding: 11px;
    border: none;
    border-radius: 8px;
    background: #1B3A5C;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: .82rem;
    font-weight: 700;
    color: #fff;
    cursor: pointer;
    transition: background .15s;
}
.cfd-apply:hover { background: #142d48; }

@media (max-width: 640px) {
    #cat-filter-drawer {
        border: 1.5px solid #E8E3D9;
        border-radius: 14px;
    }
    #cat-filter-drawer[hidden] {
        display: none !important;
    }
}

.cfd-dot {
    display: inline-block;
    width: 13px; height: 13px;
    border-radius: 50%;
    flex-shrink: 0;
    border: 1px solid rgba(0,0,0,.08);
}
.cfd-colour-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
}
.cfd-show-more {
    background: none;
    border: none;
    color: #1B3A5C;
    font-size: .78rem;
    font-weight: 700;
    cursor: pointer;
    padding: 6px 4px;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    text-decoration: underline;
    text-underline-offset: 2px;
}

.cfd-colour-chip { display:inline-flex; align-items:center; gap:8px; }
.cfd-colour-chip .cfd-dot { flex-shrink:0; margin-right:3px; }

.chip-count {
    font-size: .68rem;
    font-weight: 700;
    color: inherit;
    opacity: 0.6;
    margin-left: 3px;
}
.cfd-chip.is-selected .chip-count { opacity: 0.8; }

.tab-count {
    display: inline-block;
    font-size: .68rem;
    font-weight: 700;
    color: inherit;
    opacity: 0.55;
    margin-left: 4px;
}

@media (max-width: 640px) {
    
    .cat-filters {
        flex-direction: column;
        align-items: stretch;
        padding: 0 0 12px;
        gap: 0;
    }

    
    #cat-tabs {
        flex: none;
        width: 100%;
        padding: 0 14px;
        justify-content: flex-start;
        -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
        mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    }
    #cat-tabs::-webkit-scrollbar { display: none; }
    .cat-tab { flex-shrink: 0; }

    
    .cat-toolbar-right {
        position: static;
        border-left: none;
        border-top: 1px solid #E8E3D9;
        margin-top: 8px;
        padding: 8px 14px 0;
        justify-content: center;
        width: 100%;
    }

    .cat-filter-btn {
        width: 100%;
        justify-content: center;
    }

    .cat-filter-btn {
        flex-shrink: 0;
    }
}

.qv-width-btns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    margin-top: 2px;
}
.qv-width-btn {
    padding: 10px 0;
    border: 1.5px solid var(--border, #E8E3D9);
    border-radius: 8px;
    background: var(--surface, #FFFFFF);
    color: var(--ink-2, #5C574F);
    font-size: 0.88rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.15s;
}
.qv-width-btn:hover {
    border-color: var(--red, #E03040);
    color: var(--red, #E03040);
}
.qv-width-btn.active {
    background: var(--red, #E03040);
    border-color: var(--red, #E03040);
    color: #fff;
}
