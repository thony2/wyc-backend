.qv-feature-item { display:flex; align-items:center; gap:9px; }
.qv-feature-icon { width:32px; height:32px; border-radius:8px; background:#F2EFE8; display:flex; align-items:center; justify-content:center; color:#1B3A5C; font-size:.85rem; flex-shrink:0; }
.qv-feature-label { font-size:.8rem; color:#1A1714; font-weight:500; }
.qv-no-features { font-size:.85rem; color:#9C9589; margin-bottom:16px; }

.qv-room-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-bottom:16px; }
.qv-room-item { display:flex; flex-direction:column; align-items:center; gap:5px; padding:10px 6px; border-radius:8px; font-size:.72rem; font-weight:600; text-align:center; border:1.5px solid #E8E3D9; }
.qv-room-item--on { background:#F2EFE8; color:#1B3A5C; border-color:#1B3A5C; }
.qv-room-item--off { background:#fff; color:#9C9589; }
.qv-room-item i { font-size:1.1rem; }

.qv-comfort { background:#F8F6F1; border-radius:10px; padding:14px 14px 4px; }
.qv-bar-row { display:flex; align-items:center; gap:14px; padding:10px 0; border-top:1px solid #E8E3D9; margin-bottom:0; }
.qv-bar-row:last-child { margin-bottom:0; }
.qv-bar-label { font-size:.75rem; color:#5C574F; width:80px; flex-shrink:0; letter-spacing:.04em; text-transform:uppercase; font-weight:700; }
.qv-bar { flex:1; display:flex; gap:3px; }
.qv-bar-seg { flex:1; height:6px; border-radius:3px; }
.qv-bar-seg--on { background:#1B3A5C; }
.qv-bar-seg--off { background:#E8E3D9; }
.qv-bar-val { font-size:.72rem; font-weight:600; color:#1B3A5C; width:80px; text-align:right; flex-shrink:0; white-space:nowrap; }

.qv-calc-col { background:#F8F6F1; border-radius:12px; padding:20px; display:flex; flex-direction:column; gap:14px; }
.qv-calc-sub { font-size:.82rem; color:#5C574F; margin:0; }
.qv-calc-mode { display:flex; background:#E8E3D9; border-radius:8px; padding:3px; gap:3px; }
.qv-calc-mode-btn { flex:1; padding:8px; border:none; border-radius:6px; font-size:.8rem; font-weight:600; cursor:pointer; background:transparent; color:#5C574F; transition:all .15s; }
.qv-calc-mode-btn.active { background:#fff; color:#1B3A5C; box-shadow:0 1px 3px rgba(0,0,0,.1); }
.qv-calc-inputs { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.qv-calc-inputs.qv-panel-hidden { display:none !important; }
.qv-calc-field { display:flex; flex-direction:column; gap:5px; }
.qv-calc-field label { font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:#9C9589; }
.qv-calc-field input { padding:10px 12px; border:1.5px solid #E8E3D9; border-radius:8px; font-size:.95rem; font-family:inherit; color:#1A1714; background:#fff; outline:none; transition:border-color .2s; }
.qv-calc-field input:focus { border-color:#1B3A5C; }
.qv-calc-checks { display:flex; flex-direction:column; gap:8px; }
.qv-calc-check { display:flex; align-items:center; gap:8px; font-size:.83rem; color:#1A1714; cursor:pointer; }
.qv-calc-check input { width:16px; height:16px; accent-color:#1B3A5C; cursor:pointer; }
.qv-calc-check em { color:#9C9589; font-style:normal; }
.qv-calc-result { background:#1B3A5C; border-radius:10px; padding:16px; color:#fff; }
.qv-calc-result-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:4px; }
.qv-calc-label { font-size:.72rem; text-transform:uppercase; letter-spacing:.08em; color:rgba(255,255,255,.6); }
.qv-calc-area-out { font-size:.78rem; color:rgba(255,255,255,.6); }
.qv-calc-total { font-size:2rem; font-weight:900; color:#fff; margin-bottom:12px; }
.qv-calc-breakdown { display:flex; flex-direction:column; gap:5px; border-top:1px solid rgba(255,255,255,.15); padding-top:10px; }
.qv-calc-row { display:flex; justify-content:space-between; font-size:.8rem; color:rgba(255,255,255,.75); }

.qv-close { position:absolute; top:14px; right:14px; width:34px; height:34px; border-radius:50%; background:rgba(0,0,0,.06); border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; color:#5C574F; font-size:.9rem; z-index:10; transition:background .15s; }
.qv-close:hover { background:rgba(0,0,0,.12); }

#colour-lightbox { position:fixed; inset:0; z-index:9999; display:none; align-items:center; justify-content:center; }
#colour-lightbox.is-open { display:flex; }
.clb-backdrop { position:absolute; inset:0; background:rgba(0,0,0,.85); }
.clb-box { position:relative; z-index:1; max-width:560px; width:90vw; background:#fff; border-radius:14px; overflow:hidden; box-shadow:0 24px 80px rgba(0,0,0,.4); }
.clb-img { width:100%; aspect-ratio:4/3; object-fit:cover; display:block; }
.clb-close { position:absolute; top:12px; right:12px; width:36px; height:36px; border-radius:50%; background:rgba(0,0,0,.5); border:none; color:#fff; font-size:1rem; cursor:pointer; display:flex; align-items:center; justify-content:center; z-index:2; transition:background .15s; }
.clb-close:hover { background:rgba(0,0,0,.75); }
.clb-arrow { position:absolute; top:50%; transform:translateY(-50%); width:40px; height:40px; border-radius:50%; background:rgba(0,0,0,.45); border:none; color:#fff; font-size:.95rem; cursor:pointer; display:flex; align-items:center; justify-content:center; z-index:2; transition:background .15s; }
.clb-arrow:hover { background:rgba(0,0,0,.7); }
.clb-prev { left:12px; }
.clb-next { right:12px; }
.clb-label { padding:12px 16px 4px; font-size:1rem; font-weight:700; color:#1A1714; text-align:center; }
.clb-dots { display:flex; justify-content:center; gap:6px; padding:8px 16px 16px; }
.clb-dot { width:8px; height:8px; border-radius:50%; background:#E8E3D9; cursor:pointer; transition:background .15s; border:none; }
.clb-dot.active { background:#1B3A5C; }

.cat-swatch--img { border-radius:8px !important; width:36px !important; height:36px !important; }
.qv-swatch--img { border-radius:6px !important; }

#colour-lightbox:not(.is-open) { display:none !important; }
#colour-lightbox.is-open { display:flex !important; }

html, body {
    overflow-x: hidden;
    max-width: 100vw;
}
