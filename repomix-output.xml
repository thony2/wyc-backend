# ============================================================
# West Yorkshire Carpets — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── APPLICATION ─────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# The exact origin of your frontend (no trailing slash).
# For local dev this is likely http://localhost:5500 (Live Server)
# For production set to your actual domain, e.g. https://westyorkshirecarpets.co.uk
ALLOWED_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# ── DATABASE ────────────────────────────────────────────────
# SQLite is used by default (great for local dev & small VPS deploys).
# Set DB_TYPE=postgres to switch to PostgreSQL.
DB_TYPE=sqlite

# SQLite: path to the database file (relative to backend root)
SQLITE_PATH=./data/wyc_leads.db

# PostgreSQL: only required if DB_TYPE=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wyc_leads
POSTGRES_USER=wyc_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── SECURITY ────────────────────────────────────────────────
# Random 32+ character string — used for CSRF token signing
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=82db81d0802b0fc42d8a19e602dbfc736331604f21c816fe0e8d9a6e3d5cb6e4

# ── EMAIL NOTIFICATIONS ─────────────────────────────────────
# Set MAIL_ENABLED=true to send admin email on each new lead.
MAIL_ENABLED=false

# SMTP settings — works with Gmail, Mailgun, Brevo (Sendinblue), AWS SES, etc.
# For Gmail: enable 2FA and create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password_here

# Where admin notification emails are sent FROM and TO
MAIL_FROM="West Yorkshire Carpets <noreply@westyorkshirecarpets.co.uk>"
MAIL_TO=admin@westyorkshirecarpets.co.uk

# ── ADMIN DASHBOARD ─────────────────────────────────────────
# Simple bearer token to protect the admin API endpoints.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=78ba5c360b6acba03e0695cae2070951a09c3204c9eaf170

# ── RATE LIMITING ───────────────────────────────────────────
# Max lead submissions per IP per 15-minute window
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=900000

# ── LOGGING ─────────────────────────────────────────────────
# 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info
</file>

