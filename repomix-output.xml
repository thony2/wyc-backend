}

.contact-heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    color: var(--ink);
    line-height: 1.15;
    margin-bottom: 16px;
}
.contact-heading em {
    font-style: italic;
    color: var(--red);
}

.contact-sub {
    font-size: 0.95rem;
    color: var(--grey);
    line-height: 1.7;
