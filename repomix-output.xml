#modal-overlay .booking-type-wrap{position:relative;margin-bottom:10px}
#modal-overlay .booking-type-btn{width:100%;display:flex;align-items:center;gap:8px;padding:9px 12px;background:#2E2F36;border:1px solid rgba(255,255,255,.07);border-radius:8px;color:#A2A8B0;font-size:.83rem;font-family:'Inter',sans-serif;cursor:pointer;transition:all .18s;text-align:left}
#modal-overlay .booking-type-btn:hover{border-color:rgba(255,255,255,.15);color:#E8E9EF;background:#3A3B44}
#modal-overlay .booking-type-btn.open{border-color:rgba(222,56,72,.4);color:#E8E9EF;background:#3A3B44;border-bottom-left-radius:0;border-bottom-right-radius:0}
#modal-overlay .booking-type-btn.has-value{border-color:rgba(59,130,246,.3);background:rgba(59,130,246,.05);color:#E8E9EF}
#modal-overlay .booking-type-dropdown{position:absolute;top:100%;left:0;right:0;background:#3A3B44;border:1px solid rgba(222,56,72,.4);border-top:none;border-radius:0 0 10px 10px;overflow:hidden;max-height:0;opacity:0;transition:max-height .25s cubic-bezier(.4,0,.2,1),opacity .2s;z-index:300;pointer-events:none}
#modal-overlay .booking-type-dropdown.open{max-height:250px;opacity:1;pointer-events:all}
#modal-overlay .booking-type-option{padding:10px 14px;font-size:.82rem;color:#A2A8B0;cursor:pointer;transition:background .12s,color .12s;border-bottom:1px solid rgba(255,255,255,.07);font-family:'Inter',sans-serif;display:flex;align-items:center;gap:10px}
