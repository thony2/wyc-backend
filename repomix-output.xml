function statusColor(s) {
  return {new:'#60A5FA',contacted:'#FCD34D',quoted:'#A78BFA',won:'#6EE7B7',lost:'#9CA3AF',spam:'#F87171'}[s]||'#60A5FA';
}
function formatLeadDate(d) {
  if (!d) return '';
  try { return new Date(d+'T12:00:00').toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}); }
  catch(e) { return d; }
}
function timeAgo(d) {
  const diff=Date.now()-new Date(d), m=Math.floor(diff/60000), h=Math.floor(diff/3600000), dy=Math.floor(diff/86400000);
  if(m<1)return'Just now'; if(m<60)return`${m}m ago`; if(h<24)return`${h}h ago`; if(dy<7)return`${dy}d ago`;
  return new Date(d).toLocaleDateString('en-GB');
}
function esc(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function showToast(msg, type='success') {
