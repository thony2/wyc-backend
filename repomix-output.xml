#modal-overlay .booking-type-option:hover{background:#2E2F36;color:#E8E9EF}
#modal-overlay .booking-type-option.active{color:#F0EEE4;font-weight:500}
#modal-overlay .booking-type-icon{color:#6B7280;font-size:.8rem}
#modal-overlay .booking-type-chevron{color:#6B7280;font-size:.65rem;transition:transform .2s;margin-left:auto}
#modal-overlay .booking-type-btn.open .booking-type-chevron{transform:rotate(180deg)}

:root{
  --wyc-red:#E03040;--wyc-navy:#1B3A5C;--wyc-gold:#C49A3C;
  --wyc-ink:#1A1714;--wyc-ink2:#5C574F;--wyc-ink3:#9C9589;
  --wyc-bg:#F8F6F1;--wyc-surface:#F2EFE8;--wyc-border:#E8E3D9;
  --ps-slate:#1A1714;--ps-slate-mid:#1B3A5C;--ps-red:#E03040;--ps-red-dark:#B8202F;
  --ps-white:#FFFFFF;--ps-cream:#F8F6F1;--ps-cream-mid:#F2EFE8;--ps-grey:#5C574F;
  --ps-grey-light:#9C9589;--ps-border:#E8E3D9;--ps-success:#16a34a;
  --ps-warn:#C49A3C;--ps-danger:#E03040;
}
#products-section{background:#f0ede8;min-height:100vh;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:14px;display:none}
#products-section.active{display:block}

#products-section .ps-topbar{background:var(--ps-white);border-bottom:1px solid var(--ps-border);padding:0 26px;height:58px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:50}
#products-section .ps-topbar h1{font-size:1.02rem;font-weight:700;color:var(--ps-slate)}
#products-section .ps-topbar-stats{display:flex;gap:20px}
#products-section .topbar-stat{font-size:.8rem;color:var(--ps-grey)}
#products-section .topbar-stat strong{color:var(--ps-slate)}
#products-section .topbar-stat.warn strong{color:var(--ps-warn)}
#products-section .ps-page-content{padding:26px}

#products-section .btn,#product-modal .btn,#offer-modal .btn{display:inline-flex;align-items:center;gap:6px;padding:9px 18px;border-radius:6px;font-size:.87rem;font-weight:600;cursor:pointer;border:none;font-family:inherit;transition:all .15s}
#products-section .btn-primary,#product-modal .btn-primary,#offer-modal .btn-primary{background:var(--ps-red);color:var(--ps-white)}
#products-section .btn-primary:hover,#product-modal .btn-primary:hover,#offer-modal .btn-primary:hover{background:var(--ps-red-dark)}
#products-section .btn-secondary,#product-modal .btn-secondary,#offer-modal .btn-secondary{background:var(--ps-cream);color:var(--ps-slate)}
#products-section .btn-secondary:hover,#product-modal .btn-secondary:hover,#offer-modal .btn-secondary:hover{background:var(--ps-cream-mid)}
#products-section .btn-sm,#product-modal .btn-sm,#offer-modal .btn-sm{padding:6px 13px;font-size:.79rem}
#products-section .btn-import{display:flex;align-items:center;gap:6px;padding:9px 18px;background:#1a2332;color:var(--ps-white);border:1px solid rgba(255,255,255,.1);border-radius:6px;font-size:.87rem;font-weight:600;cursor:pointer;white-space:nowrap;transition:background .15s}
#products-section .btn-import:hover{background:#243044}
#bulk-import-modal{position:fixed;top:0;left:0;right:0;bottom:0;width:100vw;height:100vh;background:rgba(0,0,0,.6);z-index:9999;display:none;align-items:center;justify-content:center;padding:20px;box-sizing:border-box;backdrop-filter:blur(3px)}
#bulk-import-modal.open{display:flex}
#bulk-import-modal .bim{background:var(--ps-white);border-radius:14px;width:100%;max-width:720px;max-height:90vh;overflow-y:auto;box-shadow:0 10px 48px rgba(0,0,0,.2)}
#bulk-import-modal .bim-head{padding:20px 24px 16px;border-bottom:1px solid var(--ps-border);display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;background:var(--ps-white);z-index:1}
#bulk-import-modal .bim-head h3{font-size:1rem;font-weight:700;color:var(--ps-slate)}
#bulk-import-modal .bim-body{padding:20px 24px}
#bulk-import-modal .bim-foot{padding:14px 24px;border-top:1px solid var(--ps-border);display:flex;justify-content:space-between;align-items:center;gap:10px;position:sticky;bottom:0;background:var(--ps-white)}
#bulk-import-modal .bim-drop{border:2px dashed var(--ps-border);border-radius:10px;padding:32px 20px;text-align:center;cursor:pointer;transition:all .2s;background:var(--ps-cream);position:relative;margin-bottom:16px}
#bulk-import-modal .bim-drop:hover,.bim-drop.drag-over{border-color:var(--ps-red);background:#fff5f5}
#bulk-import-modal .bim-drop input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}
#bulk-import-modal .bim-drop-icon{font-size:2rem;color:var(--ps-red);margin-bottom:8px}
#bulk-import-modal .bim-drop strong{display:block;color:var(--ps-slate);margin-bottom:4px}
#bulk-import-modal .bim-drop span{font-size:.78rem;color:var(--ps-grey)}
#bulk-import-modal .bim-table-wrap{max-height:320px;overflow-y:auto;border:1px solid var(--ps-border);border-radius:8px;margin-bottom:16px}
#bulk-import-modal table{width:100%;border-collapse:collapse;font-size:.78rem}
#bulk-import-modal th{background:var(--ps-cream);padding:8px 12px;text-align:left;font-weight:600;color:var(--ps-grey);font-size:.68rem;text-transform:uppercase;letter-spacing:.06em;position:sticky;top:0;border-bottom:1px solid var(--ps-border)}
#bulk-import-modal td{padding:7px 12px;border-bottom:1px solid var(--ps-border);color:var(--ps-slate);vertical-align:middle}
#bulk-import-modal tr:last-child td{border-bottom:none}
#bulk-import-modal tr.row-ok td:first-child{border-left:3px solid var(--ps-success)}
#bulk-import-modal tr.row-skip td:first-child{border-left:3px solid var(--ps-warn)}
#bulk-import-modal tr.row-err td:first-child{border-left:3px solid var(--ps-danger)}
#bulk-import-modal .bim-stats{display:flex;gap:12px;margin-bottom:16px;flex-wrap:wrap}
#bulk-import-modal .bim-stat{background:var(--ps-cream);border-radius:8px;padding:10px 16px;flex:1;min-width:80px}
#bulk-import-modal .bim-stat-n{font-size:1.4rem;font-weight:700;color:var(--ps-slate)}
#bulk-import-modal .bim-stat-l{font-size:.72rem;color:var(--ps-grey)}
#bulk-import-modal .bim-progress{height:6px;background:var(--ps-border);border-radius:4px;overflow:hidden;margin-bottom:8px}
#bulk-import-modal .bim-progress-bar{height:100%;background:var(--ps-red);border-radius:4px;transition:width .2s}
#bulk-import-modal .bim-log{font-size:.74rem;color:var(--ps-grey);max-height:120px;overflow-y:auto;background:var(--ps-cream);border-radius:6px;padding:10px 12px;font-family:monospace}
#products-section .btn-add{display:flex;align-items:center;gap:6px;padding:9px 18px;background:var(--ps-red);color:var(--ps-white);border:none;border-radius:6px;font-size:.87rem;font-weight:600;cursor:pointer;white-space:nowrap;transition:background .15s}
#products-section .btn-add:hover{background:var(--ps-red-dark)}

#products-section .toolbar{display:flex;flex-direction:column;gap:10px;margin-bottom:22px}
#products-section .cat-tabs{display:flex;gap:6px;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding-bottom:2px}
#products-section .cat-tabs::-webkit-scrollbar{display:none}
#products-section .cat-tab{padding:7px 15px;border-radius:100px;border:1.5px solid var(--ps-border);background:var(--ps-white);color:var(--ps-grey);font-size:.82rem;font-weight:500;cursor:pointer;transition:all .15s;white-space:nowrap}
#products-section .cat-tab:hover{border-color:var(--ps-slate);color:var(--ps-slate)}
#products-section .cat-tab.active{background:var(--ps-slate);border-color:var(--ps-slate);color:var(--ps-white)}
#products-section .toolbar-top{display:flex;gap:8px;align-items:center}
#products-section .search-wrap{position:relative;flex:1}
#products-section .search-wrap input{padding:8px 12px 8px 32px;border:1.5px solid var(--ps-border);border-radius:6px;font-size:.87rem;font-family:inherit;width:100%;color:var(--ps-slate);background:var(--ps-white)}
#products-section .search-wrap input:focus{outline:none;border-color:var(--ps-red)}
#products-section .search-icon{position:absolute;left:9px;top:50%;transform:translateY(-50%);color:var(--ps-grey-light);font-size:.85rem;pointer-events:none}

#products-section .product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(255px,1fr));gap:18px}
#products-section .product-card{background:var(--ps-white);border-radius:10px;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.08);transition:transform .2s,box-shadow .2s}
#products-section .product-card:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.09)}
#products-section .product-card.inactive{opacity:.55}
#products-section .card-img{position:relative;height:175px;background:var(--ps-cream);overflow:hidden}
#products-section .card-img img{width:100%;height:100%;object-fit:cover;transition:transform .3s}
#products-section .product-card:hover .card-img img{transform:scale(1.04)}
#products-section .card-badge{position:absolute;top:10px;left:10px;padding:3px 9px;border-radius:100px;font-size:.68rem;font-weight:700;text-transform:uppercase}
#products-section .badge-seller{background:#1a2332;color:#fff}
#products-section .badge-sale{background:var(--ps-red);color:#fff}
#products-section .badge-premium{background:#5b21b6;color:#fff}
#products-section .badge-new{background:var(--ps-success);color:#fff}
#products-section .card-hidden-tag{position:absolute;top:10px;right:10px;background:rgba(0,0,0,.65);color:white;font-size:.67rem;padding:2px 8px;border-radius:100px;font-weight:700}
#products-section .card-deal-tag{position:absolute;bottom:10px;left:10px;background:var(--ps-red);color:white;font-size:.68rem;padding:3px 9px;border-radius:100px;font-weight:700}
#products-section .card-body{padding:15px}
#products-section .card-meta{display:flex;justify-content:space-between;align-items:center;margin-bottom:5px}
#products-section .card-cat{font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;color:var(--ps-grey);font-weight:600}
#products-section .card-sku{font-size:.68rem;color:var(--ps-grey-light)}
#products-section .card-name{font-size:.95rem;font-weight:700;margin-bottom:9px;line-height:1.3;color:var(--ps-slate)}
#products-section .card-price-row{display:flex;align-items:baseline;gap:7px;margin-bottom:8px}
#products-section .card-price{font-size:1.25rem;font-weight:800;color:var(--ps-red);cursor:pointer;border-bottom:1.5px dashed transparent;transition:border-color .15s}
#products-section .card-price:hover{border-color:var(--ps-red)}
#products-section .card-price small{font-size:.68rem;font-weight:500;color:var(--ps-grey)}
#products-section .card-was{font-size:.8rem;color:var(--ps-grey-light);text-decoration:line-through}
#products-section .card-stock{font-size:.77rem;margin-bottom:12px}
#products-section .card-stock span{font-weight:700;cursor:pointer;border-bottom:1px dashed transparent;transition:border-color .15s}
#products-section .card-stock span:hover{border-bottom-color:currentColor}
#products-section .stock-ok{color:var(--ps-success)}
#products-section .stock-low{color:var(--ps-warn)}
#products-section .stock-zero{color:var(--ps-danger)}
#products-section .card-actions{display:flex;gap:5px}
#products-section .btn-edit{flex:1;padding:8px;background:var(--ps-cream);color:var(--ps-slate);border:none;border-radius:6px;font-size:.82rem;font-weight:600;cursor:pointer;transition:background .15s}
#products-section .btn-edit:hover{background:var(--ps-cream-mid)}
#products-section .btn-vis{padding:8px 10px;background:var(--ps-cream);color:var(--ps-grey);border:none;border-radius:6px;font-size:.82rem;cursor:pointer;transition:all .15s}
#products-section .btn-vis:hover{background:var(--ps-cream-mid)}
#products-section .btn-vis.on{background:#d1fae5;color:var(--ps-success)}
#products-section .btn-del{padding:8px 10px;background:#fee2e2;color:var(--ps-danger);border:none;border-radius:6px;font-size:.82rem;cursor:pointer;transition:background .15s}
#products-section .btn-del:hover{background:#fecaca}

#products-section .loading{display:flex;align-items:center;justify-content:center;padding:72px}
#products-section .spinner{width:30px;height:30px;border:3px solid var(--ps-border);border-top-color:var(--ps-red);border-radius:50%;animation:spin .7s linear infinite}
#products-section .empty{text-align:center;padding:72px 20px}
