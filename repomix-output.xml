#modal-overlay .dp-header{display:flex;align-items:center;justify-content:space-between;padding:10px 12px 6px}
#modal-overlay .dp-nav-btn{background:none;border:none;color:#A2A8B0;cursor:pointer;padding:4px 8px;border-radius:4px;font-size:.9rem}
