function buildProductCard(p) {
  const sc = p.stock_level===0?'stock-zero':p.stock_level<=5?'stock-low':'stock-ok';
  const sl = p.stock_level===0?'Out of stock':p.stock_level<=5?`Low: ${p.stock_level}`:`${p.stock_level} in stock`;
  return `<div class="product-card ${p.is_active?'':'inactive'}">
    <div class="card-img">
      ${p.img_url?`<img src="${p.img_url}" alt="${p.name}" loading="lazy" onerror="this.style.display='none'">`:``}
      ${p.badge&&p.badge_type?`<div class="card-badge badge-${p.badge_type}">${p.badge}</div>`:''}
      ${!p.is_active?`<div class="card-hidden-tag">HIDDEN</div>`:''}
      ${p.is_deal?`<div class="card-deal-tag">DEAL</div>`:''}
    </div>
    <div class="card-body">
      <div class="card-meta"><span class="card-cat">${p.category_slug}</span>${p.sku?`<span class="card-sku">${p.sku}</span>`:''}</div>
      <div class="card-name">${p.name}</div>
      <div class="card-price-row">
        <span class="card-price" id="pp-${p.id}" onclick="editPrice(${p.id})" title="Click to edit">
          £${parseFloat(p.price).toFixed(2)}<small>/m²</small>
        </span>
        ${p.original_price?`<span class="card-was">£${parseFloat(p.original_price).toFixed(2)}</span>`:''}
      </div>
      <div class="card-stock">Stock: <span id="ps-${p.id}" class="${sc}" onclick="editStock(${p.id})" title="Click to edit">${sl}</span></div>
      <div class="card-actions">
        <button class="btn-edit" onclick="editProduct(${p.id})"><i class="fa-solid fa-pen-to-square"></i> Edit</button>
        <button class="btn-vis ${p.is_active?'on':''}" onclick="toggleActive(${p.id},${p.is_active})" title="${p.is_active?'Hide':'Show'}"><i class="fa-solid ${p.is_active?'fa-eye':'fa-eye-slash'}"></i></button>
        <button class="btn-del" onclick="deleteProduct(${p.id},'${p.name.replace(/'/g,"\\'")}')">🗑️</button>
      </div>
    </div>


  </div>`;
}

function filterCat(cat) { currentCat = cat; buildProductsUI(); }
function searchProducts(q) {
  const lq = q.toLowerCase();
  const filtered = allProducts.filter(p =>
    (currentCat==='all' || p.category_slug===currentCat) &&
    (p.name.toLowerCase().includes(lq) || (p.sku||'').toLowerCase().includes(lq))
  );
  const grid = document.querySelector('#products-section .product-grid');
  if (grid) grid.innerHTML = filtered.map(buildProductCard).join('');
}

async function editPrice(id) {
  const p = allProducts.find(x=>x.id==id); if (!p) return;
  const val = prompt(`New price for "${p.name}"\nCurrent: £${parseFloat(p.price).toFixed(2)}/m²\n\nEnter new price (£):`);
  if (val === null) return;
  const price = parseFloat(val);
  if (isNaN(price)||price<0) { showToast('Invalid price','error'); return; }
  const res = await panelApi(`/products/${id}/price`, {method:'PATCH', body:JSON.stringify({price})});
  if (!res||!res.ok) { showToast('Error updating price','error'); return; }
  p.price = price;
  const el = document.getElementById(`pp-${id}`);
  if (el) el.innerHTML = `£${price.toFixed(2)}<small>/m²</small>`;
  showToast(`Price updated to £${price.toFixed(2)} ✓`);
  loadProductsStats();
}
async function editStock(id) {
  const p = allProducts.find(x=>x.id==id); if (!p) return;
  const val = prompt(`New stock level for "${p.name}"\nCurrent: ${p.stock_level}\n\nEnter new stock level:`);
  if (val === null) return;
  const stock = parseInt(val);
  if (isNaN(stock)||stock<0) { showToast('Invalid stock level','error'); return; }
  const res = await panelApi(`/products/${id}/stock`, {method:'PATCH', body:JSON.stringify({stock_level:stock})});
  if (!res||!res.ok) { showToast('Error updating stock','error'); return; }
  p.stock_level = stock;
  const sc = stock===0?'stock-zero':stock<=5?'stock-low':'stock-ok';
  const sl = stock===0?'⚠️ Out of stock':stock<=5?`⚠️ Low: ${stock}`:`✓ ${stock} in stock`;
  const el = document.getElementById(`ps-${id}`);
  if (el) { el.className = sc; el.textContent = sl; }
  showToast(`Stock updated to ${stock} ✓`);
  loadProductsStats();
}
async function toggleActive(id, current) {
  const res = await panelApi(`/products/${id}/visibility`, {method:'PATCH', body:JSON.stringify({is_active:current?0:1})});
  if (!res) return;
  showToast(current ? 'Product hidden from website' : 'Product now visible on website');
  await renderProducts(); loadProductsStats();
}

const CLOUDINARY_CLOUD = 'drcafhzau';
const CLOUDINARY_PRESET = 'fpad01oz';

async function uploadToCloudinary(file) {
  const fd = new FormData();
  fd.append('file', file);
  fd.append('upload_preset', CLOUDINARY_PRESET);
  const res = await fetch('https://api.cloudinary.com/v1_1/' + CLOUDINARY_CLOUD + '/image/upload', {method:'POST',body:fd});
  const data = await res.json();
  if (data.secure_url) return data.secure_url;
  throw new Error(data.error?.message || 'Upload failed');
}

