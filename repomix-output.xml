        <div class="modal-field"><label>Ref</label><span id="modal-id" style="font-size:.78rem;color:#A2A8B0;font-family:monospace;letter-spacing:.04em">—</span></div>
      </div>
      <div class="modal-section" id="modal-message-wrap" style="display:none">
        <span class="modal-section-label">Message from customer</span>
        <div class="modal-message-box" id="modal-message">—</div>
      </div>

      <div class="booking-section">
        <div class="booking-section-title">
          <i class="fa-solid fa-calendar-check"></i>Schedule This Job
        </div>
        <div id="current-booking-info"></div>
        <div class="booking-row">
          <div class="date-col" style="position:relative">
            <div class="booking-field-label">Date</div>
            <button type="button" class="booking-trigger" id="date-trigger" onclick="toggleDateDropdown()">
              <i class="fa-regular fa-calendar"></i>
              <span id="date-trigger-label">Pick a date</span>
            </button>
            <input id="booking-date" type="hidden">
            <div class="date-picker-dropdown" id="date-picker-dropdown">
              <div id="date-picker-inner"></div>
            </div>
          </div>
          <div class="time-col">
            <div class="booking-field-label">Time</div>
            <button type="button" class="booking-trigger" id="time-trigger" onclick="toggleTimePicker()">
              <i class="fa-regular fa-clock"></i>
              <span id="time-trigger-label">Pick a time</span>
            </button>
            <input id="booking-time" type="hidden">
            <div class="time-picker-dropdown" id="time-picker-dropdown">
              <div class="time-picker-grid" id="time-picker-grid"></div>
            </div>
          </div>
        </div>
        <div>
          <div class="booking-field-label">Type of Visit</div>
          <div class="booking-type-wrap" id="booking-type-wrap">
            <button type="button" class="booking-type-btn" id="booking-type-btn" onclick="toggleBookingType()">
              <i class="fa-solid fa-tag booking-type-icon"></i>
              <span class="booking-type-label" id="booking-type-label">Select type…</span>
              <i class="fa-solid fa-chevron-down booking-type-chevron"></i>
            </button>
            <div class="booking-type-dropdown" id="booking-type-dropdown">
              <div class="booking-type-option" onclick="pickBookingType('','Select type…','fa-tag')"><span style="width:20px;text-align:center">—</span>No type</div>
              <div class="booking-type-option" onclick="pickBookingType('measurement','Measurement Visit','fa-ruler-combined')"><span style="width:20px;text-align:center">📏</span>Measurement Visit</div>
              <div class="booking-type-option" onclick="pickBookingType('installation','Installation','fa-hammer')"><span style="width:20px;text-align:center">🔨</span>Installation</div>
              <div class="booking-type-option" onclick="pickBookingType('callback','Callback','fa-phone')"><span style="width:20px;text-align:center">📞</span>Callback</div>
              <div class="booking-type-option" onclick="pickBookingType('quote','Quote Visit','fa-sterling-sign')"><span style="width:20px;text-align:center">💷</span>Quote Visit</div>
            </div>
            <input type="hidden" id="booking-type">
          </div>
        </div>
        <div style="margin-top:10px">
          <div class="booking-field-label">Job Notes</div>
          <textarea class="booking-notes-input" id="booking-notes"
            placeholder="e.g. Measure living room + hallway, customer prefers morning…"></textarea>
        </div>
      </div>

      <div class="modal-section">
        <span class="modal-section-label">Update Status</span>
        <div class="status-pills" id="status-pills-modal">
          <button class="status-pill pill-new"       data-status="new"       onclick="updateLeadStatus('new')">New</button>
          <button class="status-pill pill-contacted" data-status="contacted" onclick="updateLeadStatus('contacted')">Contacted</button>
          <button class="status-pill pill-quoted"    data-status="quoted"    onclick="updateLeadStatus('quoted')">Quoted</button>
          <button class="status-pill pill-won"       data-status="won"       onclick="updateLeadStatus('won')">Won</button>
          <button class="status-pill pill-lost"      data-status="lost"      onclick="updateLeadStatus('lost')">Lost</button>
          <button class="status-pill pill-spam"      data-status="spam"      onclick="updateLeadStatus('spam')">Spam</button>
        </div>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn btn-green" onclick="saveBooking()" style="width:100%;justify-content:center"><i class="fa-solid fa-calendar-check"></i> Save Booking</button>
      <div class="foot-row" style="display:flex;gap:8px;width:100%">
        <a id="modal-call-btn" class="btn btn-primary" href="tel:" style="flex:1;justify-content:center"><i class="fa-solid fa-phone"></i> Call</a>
        <button class="btn btn-ghost" onclick="closeModal()" style="flex:1;justify-content:center">Close</button>
      </div>
      <button class="btn btn-danger" onclick="deleteLead()" style="background:none;border:none;color:#6B7280;font-size:.78rem;align-self:center;padding:4px 8px"><i class="fa-solid fa-trash"></i> Delete Lead</button>
    </div>
</div>



<div id="toast">
  <i class="fa-solid fa-circle-check"></i>
  <span id="toast-msg">Done!</span>
</div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
'use strict';

const LEADS_API = '';
const PANEL_API = '/api/panel';

let TOKEN = localStorage.getItem('wyc_token') || '';
let USER  = JSON.parse(localStorage.getItem('wyc_user') || 'null');

let allLeads = [], currentLead = null, leadsRefreshTimer = null;
let calYear = new Date().getFullYear(), calMonth = new Date().getMonth();
let calBookings = [], calUnscheduled = [], selectedDay = null;
let currentStatusFilter = '';
let fpDate, fpTime;

let allProducts = [], currentCat = 'all';

async function doLogin() {
  const username = document.getElementById('login-user').value.trim();
  const password = document.getElementById('login-pass').value;
  const errEl    = document.getElementById('login-error');
  errEl.style.display = 'none';
  if (!username || !password) {
    errEl.textContent = 'Please enter your username and password.';
    errEl.style.display = 'block';
    return;
  }
  try {
    const res  = await fetch(`${PANEL_API}/login`, {
      method:  'POST',
      headers: {'Content-Type':'application/json'},
      body:    JSON.stringify({username, password}),
    });
    const data = await res.json();
    if (!res.ok) {
      errEl.textContent = data.error || 'Login failed. Please try again.';
      errEl.style.display = 'block';
      return;
    }
    TOKEN = data.token;
    USER  = data;
    localStorage.setItem('wyc_token', TOKEN);
    localStorage.setItem('wyc_user', JSON.stringify(data));
    showApp();
  } catch(e) {
    errEl.textContent = 'Connection error. Please try again.';
    errEl.style.display = 'block';
  }
}

function doLogout(reason) {
  TOKEN = ''; USER = null;
  localStorage.removeItem('wyc_token');
  localStorage.removeItem('wyc_user');
  allLeads = []; allProducts = [];
  clearInterval(leadsRefreshTimer);
  document.getElementById('app').style.display          = 'none';
  document.getElementById('login-screen').style.display = 'flex';
  const errEl = document.getElementById('login-error');
  if (reason === 'expired') {
    errEl.textContent = 'Your session has expired. Please log in again.';
    errEl.style.display = 'block';
  } else {
    errEl.style.display = 'none';
  }
  document.getElementById('login-pass').value = '';
}

function showApp() {
  document.getElementById('login-screen').style.display = 'none';
  document.getElementById('app').style.display          = 'block';
  document.getElementById('sidebar-username').textContent = USER?.username || 'Admin';
  activateSection('leads');
  loadLeadsData();
  loadProductsStats();
  startLeadsAutoRefresh();
}

function activateSection(name) {
  const importEl   = document.getElementById('import-section');
  if (importEl) { importEl.classList.toggle('active', name === 'import'); importEl.style.display = name === 'import' ? 'block' : 'none'; }
  const leadsEl    = document.getElementById('leads-section');
  const productsEl = document.getElementById('products-section');
  leadsEl.classList.toggle('active',    name === 'leads');
  productsEl.classList.toggle('active', name === 'products');
  const bib = document.getElementById('bulk-import-btn');
  if (bib) bib.style.display = name === 'products' ? 'inline-flex' : 'none';
  document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
  if (name === 'leads') {
    document.getElementById('nav-all-leads')?.classList.add('active');
    if (!fpDate) setTimeout(initPickers, 50);
  }
  if (name === 'import') {    document.getElementById('nav-import')?.classList.add('active');  }  if (name === 'products') {
    document.getElementById('nav-products')?.classList.add('active');
    if (!allProducts.length) renderProducts();
  }
}

let _dpYear, _dpMonth, _dpSelected = null;
function initPickers() {
  const now = new Date();
  _dpYear  = now.getFullYear();
  _dpMonth = now.getMonth();
  renderDateDropdown();
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.date-col')) {
      document.getElementById('date-picker-dropdown').classList.remove('open');
      document.getElementById('date-trigger').classList.remove('date-trigger-open');
    }
  });
  initTimePicker();
}
function toggleDateDropdown() {
  const drop    = document.getElementById('date-picker-dropdown');
  const trigger = document.getElementById('date-trigger');
  const isOpen  = drop.classList.contains('open');
  drop.classList.toggle('open', !isOpen);
  trigger.classList.toggle('date-trigger-open', !isOpen);
}
function renderDateDropdown() {
  const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const inner  = document.getElementById('date-picker-inner');
  if (!inner) return;
  const today  = new Date();
  const first  = new Date(_dpYear, _dpMonth, 1);
  const days   = new Date(_dpYear, _dpMonth + 1, 0).getDate();
  let startDay = first.getDay();
  startDay = startDay === 0 ? 6 : startDay - 1;
  let html = '<div class="dp-header">';
  html += '<button class="dp-nav-btn" onclick="dpNav(-1)" type="button"><i class="fa-solid fa-chevron-left"></i></button>';
  html += '<span class="dp-month-label">' + months[_dpMonth] + ' ' + _dpYear + '</span>';
  html += '<button class="dp-nav-btn" onclick="dpNav(1)" type="button"><i class="fa-solid fa-chevron-right"></i></button>';
  html += '</div><div class="dp-grid">';
  ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].forEach(d => { html += '<div class="dp-day-name">' + d + '</div>'; });
  for (let i = 0; i < startDay; i++) html += '<div class="dp-day empty"></div>';
  for (let d = 1; d <= days; d++) {
    const dateStr = _dpYear + '-' + String(_dpMonth+1).padStart(2,'0') + '-' + String(d).padStart(2,'0');
    const isToday = d === today.getDate() && _dpMonth === today.getMonth() && _dpYear === today.getFullYear();
    const isSel   = dateStr === _dpSelected;
    html += '<div class="dp-day' + (isToday ? ' today' : '') + (isSel ? ' selected' : '') + '" onclick="dpSelect(&quot;' + dateStr + '&quot;)">' + d + '</div>';
  }
  html += '</div>';
  inner.innerHTML = html;
}
function dpNav(dir) {
  _dpMonth += dir;
  if (_dpMonth > 11) { _dpMonth = 0; _dpYear++; }
  if (_dpMonth < 0)  { _dpMonth = 11; _dpYear--; }
  renderDateDropdown();
}
function dpSelect(dateStr) {
  _dpSelected = dateStr;
  document.getElementById('booking-date').value = dateStr;
  const parts  = dateStr.split('-');
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  document.getElementById('date-trigger-label').textContent = parseInt(parts[2]) + ' ' + months[parseInt(parts[1])-1] + ' ' + parts[0];
  document.getElementById('date-trigger').classList.add('has-value');
  document.getElementById('date-picker-dropdown').classList.remove('open');
  document.getElementById('date-trigger').classList.remove('date-trigger-open');
  renderDateDropdown();
}

function toggleBookingType() {
  const btn  = document.getElementById('booking-type-btn');
  const drop = document.getElementById('booking-type-dropdown');
  const open = drop.classList.contains('open');
  drop.classList.toggle('open', !open);
  btn.classList.toggle('open', !open);
}
function pickBookingType(value, label, icon) {
  document.getElementById('booking-type').value = value;
  document.getElementById('booking-type-label').textContent = label;
  const btn = document.getElementById('booking-type-btn');
  btn.querySelector('.booking-type-icon').className = `fa-solid ${icon} booking-type-icon`;
  btn.classList.remove('open');
  btn.classList.toggle('has-value', !!value);
  document.getElementById('booking-type-dropdown').classList.remove('open');
  document.querySelectorAll('.booking-type-option').forEach(o =>
    o.classList.toggle('active', o.textContent.trim().includes(label) && !!value)
  );
}

function startLeadsAutoRefresh() {
  clearInterval(leadsRefreshTimer);
  leadsRefreshTimer = setInterval(() => {
    fetchLeadsDashboard();
    fetchLeads().then(() => renderLeadsTable());
  }, 30000);
}

async function fetchLeadsDashboard() {
  try {
    const r = await fetch(`${LEADS_API}/api/admin/dashboard`, {
      headers: {'Authorization': `Bearer ${TOKEN}`}
    });
    const d = await r.json();
    if (d.success) { updateLeadsStats(d.data); return true; }
    return false;
  } catch(e) { return false; }
}

async function fetchLeads() {
  try {
    const r = await fetch(`${LEADS_API}/api/admin/leads?limit=500`, {
      headers: {'Authorization': `Bearer ${TOKEN}`}
    });
    const d = await r.json();
    if (d.success) {
      allLeads = d.data.leads || (Array.isArray(d.data) ? d.data : []);
      return true;
    }
    return false;
  } catch(e) { return false; }
}

async function loadLeadsData() {
  document.getElementById('table-body').innerHTML =
    '<div class="loading"><div class="spinner"></div><br>Loading leads…</div>';
  await fetchLeadsDashboard();
  await fetchLeads();
  renderLeadsTable();
  document.getElementById('last-refresh').textContent =
    `Updated ${new Date().toLocaleTimeString('en-GB')} · auto-refreshes every 30s`;
}

function updateLeadsStats(data) {
  const s = data.summary;
  document.getElementById('stat-total').textContent    = s.total || 0;
  document.getElementById('stat-new').textContent      = s.new_count || 0;
  document.getElementById('stat-progress').textContent = (s.contacted_count||0)+(s.quoted_count||0);
  document.getElementById('stat-won').textContent      = s.won_count || 0;
  document.getElementById('stat-7days').textContent    = `${s.last_7_days||0} this week`;
  document.getElementById('mini-new').textContent       = s.new_count || 0;
  document.getElementById('mini-contacted').textContent = s.contacted_count || 0;
  document.getElementById('mini-quoted').textContent    = s.quoted_count || 0;
  document.getElementById('mini-lost').textContent      = (s.lost_count||0)+(s.spam_count||0);
  document.getElementById('nav-new-count').textContent  = s.new_count || 0;
}

function setStatusFilter(el, status) {
  currentStatusFilter = status;
  document.querySelectorAll('#status-pills .filter-pill').forEach(p => {
    p.className = 'filter-pill';
    if (p === el) p.classList.add(status ? `active-${status}` : 'active');
  });
  renderLeadsTable();
}

function renderLeadsTable() {
  const search  = document.getElementById('search-input').value.toLowerCase();
  const service = document.getElementById('filter-service').value;
  const sort    = document.getElementById('filter-sort').value;

  let leads = allLeads.filter(l => {
    if (l.name === '[Anonymised]') return false;
    const ms = !search ||
      (l.name||'').toLowerCase().includes(search) ||
      (l.phone||'').toLowerCase().includes(search) ||
      (l.postcode||'').toLowerCase().includes(search) ||
      (l.email||'').toLowerCase().includes(search);
    const ss = !currentStatusFilter || l.status === currentStatusFilter;
    const sv = !service || (l.service_type||'').toLowerCase().includes(service.toLowerCase());
    return ms && ss && sv;
  });

  leads.sort((a,b) => {
    if (sort === 'oldest') return new Date(a.created_at) - new Date(b.created_at);
    if (sort === 'name')   return (a.name||'').localeCompare(b.name||'');
    if (sort === 'booked') return (b.booking_date||'').localeCompare(a.booking_date||'');
    return new Date(b.created_at) - new Date(a.created_at);
  });

  document.getElementById('table-count').textContent = `${leads.length} of ${allLeads.length}`;

  if (!leads.length) {
    document.getElementById('table-body').innerHTML =
      '<div class="empty-state"><i class="fa-solid fa-inbox"></i><p>No leads match your filters.</p></div>';
    return;
  }

  document.getElementById('table-body').innerHTML = `
    <table>
      <thead>
        <tr>
          <th>Name</th><th>Phone</th><th>Postcode</th>
          <th>Service</th><th>Status</th><th>Received</th>
        </tr>
      </thead>
      <tbody>
        ${leads.map(l => `
          <tr onclick="openLeadModal('${l.id}')">
            <td class="td-name">${esc(l.name||'Unknown')}</td>
            <td class="td-phone">${esc(l.phone||'—')}</td>
            <td>${esc(l.postcode||'—')}</td>
            <td><span class="service-badge">${esc(l.service_type||'—')}</span></td>
            <td>${statusBadge(l.status)}</td>
            <td class="td-time">${timeAgo(l.created_at)}</td>
          </tr>
        `).join('')}
      </tbody>
    </table>`;
}

function openLeadModal(id) {
  currentLead = allLeads.find(l => l.id === id);
  if (!currentLead) return;
  const l = currentLead;
  document.getElementById('modal-name').textContent        = l.name || 'Unknown';
  document.getElementById('modal-lead-id').textContent     = 'WYC-' + (l.id||'').replace(/-/g,'').slice(0,8).toUpperCase();
  document.getElementById('modal-date').textContent        = formatLeadDate(l.created_at);
  document.getElementById('modal-phone').textContent       = l.phone || '—';
  document.getElementById('modal-postcode').textContent    = l.postcode || '—';
  document.getElementById('modal-service').textContent     = l.service_type || '—';
  document.getElementById('modal-status-badge').innerHTML  = statusBadge(l.status);
  document.querySelectorAll('#status-pills-modal .status-pill').forEach(p =>
    p.classList.toggle('is-active', p.dataset.status === l.status)
  );
  document.getElementById('modal-email').textContent       = l.email || 'Not provided';
  document.getElementById('modal-id').textContent          = (l.id||'').replace(/-/g,'').slice(0,8).toUpperCase();
  document.getElementById('modal-call-btn').href           = `tel:${l.phone||''}`;

  const msgWrap = document.getElementById('modal-message-wrap');
  if (l.message) {
    document.getElementById('modal-message').textContent = l.message;
    msgWrap.style.display = 'block';
  } else {
    msgWrap.style.display = 'none';
  }
  _dpSelected = null; document.getElementById('booking-date').value = ''; document.getElementById('date-trigger-label').textContent = 'Pick a date'; document.getElementById('date-trigger').classList.remove('has-value','date-trigger-open'); document.getElementById('date-picker-dropdown').classList.remove('open'); if(typeof renderDateDropdown==='function') renderDateDropdown();
  clearTimePicker();
  document.getElementById('date-trigger-label').textContent = 'Pick a date';
  document.getElementById('time-trigger-label').textContent = 'Pick a time';
  document.getElementById('date-trigger').classList.remove('has-value');
  document.getElementById('time-trigger').classList.remove('has-value');
  pickBookingType('', 'Select type…', 'fa-tag');
  document.getElementById('booking-notes').value = '';
  const bi = document.getElementById('current-booking-info');
  if (l.booking_date) {
    bi.innerHTML = `<div class="current-booking-badge">
      <i class="fa-solid fa-calendar-check" style="color:#27AE60"></i>
      Scheduled: ${formatLeadDate(l.booking_date)}${l.booking_time ? ' at ' + l.booking_time : ''}
      ${l.booking_type ? ` · ${l.booking_type}` : ''}
    </div>`;
    if (l.booking_date && fpDate) fpDate.setDate(l.booking_date);
    if (l.booking_time) setTimePickerValue(l.booking_time);
    if (l.booking_type) pickBookingType(l.booking_type, l.booking_type, 'fa-tag');
    if (l.booking_notes) document.getElementById('booking-notes').value = l.booking_notes || '';
  } else {
    bi.innerHTML = '';
  }

  document.getElementById('modal-overlay').classList.add('open');
}

function closeModal() {
  document.getElementById('modal-overlay').classList.remove('open');
  currentLead = null;
}
function closeModalOutside(e) {
  if (e.target.id === 'modal-overlay') closeModal();
}

async function saveBooking() {
  if (!currentLead) return;
  const date  = document.getElementById('booking-date').value;
  const time  = document.getElementById('booking-time').value;
  const btype = document.getElementById('booking-type').value;
  const notes = document.getElementById('booking-notes').value.trim();

  if (!date) { showToast('Please pick a date first', 'error'); return; }

  try {
    const r = await fetch(`${LEADS_API}/api/admin/leads/${currentLead.id}/booking`, {
      method:  'PATCH',
      headers: {'Authorization': `Bearer ${TOKEN}`, 'Content-Type': 'application/json'},
      body:    JSON.stringify({booking_date: date, booking_time: time||null, booking_type: btype||null, booking_notes: notes||null}),
    });
    if (!r.ok) throw new Error(`HTTP ${r.status}`);
    const d = await r.json();
    if (d.success) {
      const lead = allLeads.find(l => l.id === currentLead.id);
      if (lead) { lead.booking_date = date; lead.booking_time = time; lead.booking_type = btype; lead.booking_notes = notes; }
      renderLeadsTable();
      if (document.getElementById('view-calendar').style.display !== 'none') loadCalendar();
      showToast('Booking saved ✓', 'success');
    } else {
      showToast('Failed: ' + (d.error||'unknown'), 'error');
    }
  } catch(e) { showToast('Error: ' + e.message, 'error'); }
}

async function updateLeadStatus(status) {
  if (!currentLead) return;
  try {
    const r = await fetch(`${LEADS_API}/api/admin/leads/${currentLead.id}/status`, {
      method:  'PATCH',
      headers: {'Authorization': `Bearer ${TOKEN}`, 'Content-Type': 'application/json'},
      body:    JSON.stringify({status}),
    });
    if (!r.ok) throw new Error(`HTTP ${r.status}`);
    const d = await r.json();
    if (d.success) {
      const lead = allLeads.find(l => l.id === currentLead.id);
      if (lead) lead.status = status;
      currentLead.status = status;
      document.getElementById('modal-status-badge').innerHTML = statusBadge(status);
      document.querySelectorAll('#status-pills-modal .status-pill').forEach(p =>
        p.classList.toggle('is-active', p.dataset.status === status)
      );
      renderLeadsTable(); fetchLeadsDashboard();
      showToast(`Status → ${status}`, 'success');
    } else showToast('Failed: ' + d.error, 'error');
  } catch(e) { showToast('Error: ' + e.message, 'error'); }
}

async function deleteLead() {
  if (!currentLead) return;
  if (!confirm(`Permanently delete lead for ${currentLead.name || 'this lead'}?\n\nThis cannot be undone.`)) return;
  try {
    const r = await fetch(`${LEADS_API}/api/admin/leads/${currentLead.id}?hard=true`, {
      method:  'DELETE',
      headers: {'Authorization': `Bearer ${TOKEN}`},
    });
    if (!r.ok) throw new Error(`HTTP ${r.status}`);
    const d = await r.json();
    if (d.success) {
      allLeads = allLeads.filter(l => l.id !== currentLead.id);
      closeModal(); renderLeadsTable(); fetchLeadsDashboard();
      showToast('Lead deleted', 'success');
    } else showToast('Failed: ' + d.error, 'error');
  } catch(e) { showToast('Error: ' + e.message, 'error'); }
