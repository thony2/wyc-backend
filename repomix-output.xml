#modal-overlay .dp-day.other-month{color:#4B4C55}
#modal-overlay .time-picker-dropdown{position:absolute;top:100%;left:0;right:0;background:#2E2F36;border:0px solid rgba(222,56,72,.4);border-top:none;border-radius:0 0 10px 10px;max-height:0;overflow:hidden;transition:max-height .25s cubic-bezier(.4,0,.2,1),border-width 0s .25s;z-index:400;margin-top:0}
#modal-overlay #time-trigger:not(.time-trigger-open){border-bottom-color:rgba(255,255,255,.1)!important;border-color:rgba(255,255,255,.1)!important}
#modal-overlay .time-picker-dropdown.open{max-height:220px;overflow-y:auto;border-width:1px;transition:max-height .25s cubic-bezier(.4,0,.2,1)}
#modal-overlay .time-picker-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;padding:8px}
#modal-overlay .time-slot{padding:8px 4px;text-align:center;font-size:.78rem;color:#A2A8B0;cursor:pointer;border-radius:6px;transition:background .12s,color .12s;font-family:'Inter',sans-serif}
