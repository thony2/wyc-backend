#modal-overlay .dp-month-label{font-size:.84rem;font-weight:600;color:#F0EEE4;font-family:"Inter",sans-serif}
#modal-overlay .dp-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;padding:0 8px 10px}
#modal-overlay .dp-day-name{text-align:center;font-size:.62rem;font-weight:600;color:#6B7280;padding:4px 0;letter-spacing:.06em}
#modal-overlay .dp-day{text-align:center;padding:7px 2px;font-size:.8rem;color:#C8C9CF;cursor:pointer;border-radius:6px;transition:background .12s,color .12s;font-family:"Inter",sans-serif}
