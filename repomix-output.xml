<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>West Yorkshire Carpets - Icon System</title>
    
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <style>
        :root {
            /* Your Brand Palette */
            --black:      #0F0F0F;
            --navy:       #111827;
            --text:       #1A1A1A;
            --muted:      #6B7280;
            --faint:      #9CA3AF;
            --surface:    #F7F7F6;
            --border:     #E8E7E4;
            --border-med: #D4D2CE;
            --white:      #FFFFFF;
            --red:        #E03040; /* Updated to your specific brand red */
            
            /* Spacing & Radius */
            --r-md:  14px;
            --r-xl:  26px;
            --space-md: 16px;
            --space-sm: 8px;
            
            /* Icon Specifics */
            --icon-reg: 24px;
            --icon-sm: 20px;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--surface);
            color: var(--text);
            padding: 40px;
            line-height: 1.5;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        h2 { border-bottom: 2px solid var(--border); padding-bottom: 10px; margin-top: 40px; }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        /* --- UI COMPONENT STYLES --- */

        /* 1. The Capsule (Value Props / Features) */
        .capsule {
            display: inline-flex;
            align-items: center;
            gap: var(--space-sm);
            background: var(--white);
            border: 1px solid var(--border);
            padding: 8px 16px;
            border-radius: var(--r-xl);
            font-weight: 500;
            font-size: 14px;
        }
        .capsule i { color: var(--red); font-size: var(--icon-reg); }

        /* 2. The Circle Button (Floating Actions) */
        .btn-circle {
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 50%;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .btn-circle:hover { border-color: var(--red); color: var(--red); }
