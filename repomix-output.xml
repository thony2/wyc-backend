  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'wyc-import-template.csv';
  a.click();
}

function bimParseCSV(text) {
  const lines = text.trim().split('\n');
  if (lines.length < 2) return { error: 'CSV has no data rows.' };
  const headers = lines[0].split(',').map(h => h.trim().replace(/^"|"$/g, '').toLowerCase());
  const rows = [];
  for (let i = 1; i < lines.length; i++) {
    const vals = bimSplitCSVLine(lines[i]);
    if (vals.every(v => !v.trim())) continue;
    const obj = {};
    headers.forEach((h, j) => { obj[h] = (vals[j] || '').trim().replace(/^"|"$/g, ''); });
    rows.push(obj);
  }
  return { rows };
}

function bimSplitCSVLine(line) {
  const result = [];
  let cur = '', inQ = false;
  for (let i = 0; i < line.length; i++) {
    const c = line[i];
    if (c === '"') { inQ = !inQ; }
    else if (c === ',' && !inQ) { result.push(cur); cur = ''; }
    else { cur += c; }
  }
  result.push(cur);
  return result;
}

function bimValidateRow(row, idx) {
  const name = row.name || '';
  const price = parseFloat(row.price);
  if (!name) return { status: 'err', reason: 'Missing name' };
  if (!row.price || isNaN(price) || price <= 0) return { status: 'skip', reason: 'No price — skipped' };
  return { status: 'ok', reason: '' };
}

function bimHandleFile(file) {
  if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    const { rows, error } = bimParseCSV(e.target.result);
    if (error) {
      document.getElementById('bim-parse-error').style.display = 'block';
      document.getElementById('bim-parse-error').textContent = error;
      return;
    }
    document.getElementById('bim-parse-error').style.display = 'none';
    _bimRows = rows.map((r, i) => ({ ...r, _idx: i + 1, ...bimValidateRow(r, i) }));
    bimRenderPreview();
    bimShowStep('preview');
  };
  reader.readAsText(file);
}

function bimRenderPreview() {
  const ok   = _bimRows.filter(r => r.status === 'ok').length;
  const skip = _bimRows.filter(r => r.status === 'skip').length;
  const err  = _bimRows.filter(r => r.status === 'err').length;
  document.getElementById('bim-count-total').textContent = _bimRows.length;
  document.getElementById('bim-count-ok').textContent   = ok;
  document.getElementById('bim-count-skip').textContent = skip;
  document.getElementById('bim-count-err').textContent  = err;
  document.getElementById('bim-action-count').textContent = ok;
  document.getElementById('bim-action-btn').disabled = ok === 0;

  const tbody = document.getElementById('bim-preview-body');
  tbody.innerHTML = _bimRows.map(r => {
    let feats = '';
    try { feats = JSON.parse(r.features || '[]').join(', '); } catch(e) { feats = r.features || ''; }
    const badge = r.status === 'ok'
      ? '<span style="color:var(--ps-success);font-weight:600">Ready</span>'
      : r.status === 'skip'
      ? `<span style="color:var(--ps-warn)">${r.reason}</span>`
      : `<span style="color:var(--ps-danger)">${r.reason}</span>`;
    return `<tr class="row-${r.status}">
      <td>${r._idx}</td>
      <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${r.name}">${r.name || '—'}</td>
      <td>${r.price ? '£' + parseFloat(r.price).toFixed(2) : '—'}</td>
      <td style="max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${r.fibre || '—'}</td>
      <td style="max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${feats || '—'}</td>
      <td>${badge}</td>
    </tr>`;
  }).join('');
}

async function bimStartImport() {
  const toImport = _bimRows.filter(r => r.status === 'ok');
  if (!toImport.length) return;
  bimShowStep('importing');
  const log = document.getElementById('bim-log');
  const bar = document.getElementById('bim-progress-bar');
  const label = document.getElementById('bim-progress-label');
  let done = 0, errors = 0;

  for (const row of toImport) {
    const payload = {
      name:           row.name,
      category_slug:  row.category_slug || 'carpets',
      price:          parseFloat(row.price),
      original_price: parseFloat(row.original_price) || null,
      description:    row.description || null,
      img_url:        row.img_url || null,
      badge:          row.badge || null,
      badge_type:     row.badge_type || null,
      colour_family:  row.colour_family || '',
      fibre:          row.fibre || '',
      carpet_style:   row.carpet_style || '',
      softness_label: row.softness_label || '',
      thickness:      row.thickness || '',
      density:        row.density || '',
      durability:     parseInt(row.durability) || 3,
      softness:       parseInt(row.softness) || 3,
      fitting_price:  parseFloat(row.fitting_price) || 6.00,
      colours:        '[]',
      features:       row.features || '[]',
      rooms:          row.rooms || '["living","bedroom","hallway","stairs"]',
      is_featured:    parseInt(row.is_featured) || 0,
      is_deal:        parseInt(row.is_deal) || 0,
      is_active:      row.is_active !== undefined ? parseInt(row.is_active) : 1,
      stock_level:    0,
    };
    try {
      const res = await panelApi('/products', { method: 'POST', body: JSON.stringify(payload) });
      if (res && res.ok) {
        done++;
        log.innerHTML += `<div style="color:var(--ps-success)">✓ ${row.name}</div>`;
      } else {
        const d = res ? await res.json() : {};
        errors++;
        log.innerHTML += `<div style="color:var(--ps-danger)">✗ ${row.name}: ${d.error || 'failed'}</div>`;
      }
    } catch(e) {
      errors++;
      log.innerHTML += `<div style="color:var(--ps-danger)">✗ ${row.name}: ${e.message}</div>`;
    }
    log.scrollTop = log.scrollHeight;
    const pct = Math.round(((done + errors) / toImport.length) * 100);
    bar.style.width = pct + '%';
    label.textContent = `Importing… ${done + errors} of ${toImport.length}`;
    await new Promise(r => setTimeout(r, 60));
  }

  document.getElementById('bim-done-title').textContent = errors === 0 ? `${done} products imported` : `${done} imported, ${errors} failed`;
  document.getElementById('bim-done-title').style.color = errors === 0 ? 'var(--ps-success)' : 'var(--ps-warn)';
  document.getElementById('bim-done-sub').textContent = errors === 0
    ? 'All products are now live in your catalogue.'
    : 'Check the log above for failed rows.';
  bimShowStep('done');
  await renderProducts();
  loadProductsStats();
}

