      rooms,
      dominantColourFamily: colourFamilyFromName(productName),
      durability:           4, // engineered wood = good durability
      // hard floor fields
      thickness_mm,
      wear_layer_mm,
      plank_width_mm,
      species_finish:       speciesFinish,
      surface_finish,
      lay_pattern,
