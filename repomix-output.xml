    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: rgba(240,238,228,0.9);
    border: none;
    border-radius: 50%;
    color: var(--slate);
    font-size: 0.82rem;
    cursor: pointer;
    transition:
        background var(--transition),
        color var(--transition),
        transform var(--transition);
    backdrop-filter: blur(4px);
}

.qv-close:hover {
    background: var(--slate);
    color: var(--white);
    transform: rotate(90deg);
}

.qv-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    width: 100%;
    min-width: 0;
}

.qv-image-col {
    position: sticky;
    top: 0;
    border-radius: 10px 0 0 10px;
    overflow: hidden;
    background: #fff;
    align-self: start;
    padding: 20px 16px 20px 0;
}
.qv-detail-col {
    padding: 24px 28px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}
.qv-divider {
    height: 1px;
    background: #E8E3D9;
    margin: 4px 0;
    flex-shrink: 0;
}
.qv-calc-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
}
.qv-image-wrap {
    position: relative;
    overflow: hidden;
    border-radius: 14px 0 0 14px;
    background: var(--cream-mid);
}

.qv-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.qv-main-img-wrap { position: relative; }
.qv-img-zoom-hint {
    position: absolute;
    bottom: 10px;
    right: 10px;
    width: 32px;
    height: 32px;
    background: rgba(255,255,255,0.9);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    color: var(--ink-2);
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
}
.qv-main-img-wrap:hover .qv-img-zoom-hint { opacity: 1; }

.qv-content {
    padding: 32px 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow-y: auto;
}

.qv-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
}

.qv-pricing {
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    gap: 1px;
}

.qv-price-was {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--grey);
    text-decoration: line-through;
    line-height: 1;
}

.qv-price {
    font-family: var(--font-display);
    font-size: 2.1rem;
    font-weight: 600;
    color: var(--red);
    line-height: 1;
}

.qv-price small {
    font-family: var(--font-body);
    font-size: 0.72rem;
    color: var(--grey);
    font-weight: 400;
}

.qv-name {
    font-family: var(--font-display);
    font-size: 1.85rem;
    font-weight: 500;
    color: var(--slate);
    line-height: 1.15;
    margin: 0;
}

.qv-desc {
    font-size: 0.87rem;
    color: var(--grey);
    line-height: 1.72;
}

.qv-section-title {
    font-family: var(--font-body);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--grey);
    margin-top: 4px;
    margin-bottom: -5px;
}

.qv-bars {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 14px 0;
    border-top: 1px solid var(--cream-mid);
    border-bottom: 1px solid var(--cream-mid);
}

.qv-bar-row {
    display: flex;
    align-items: center;
    gap: 16px;
}

.qv-spec-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 7px 0;
    border-bottom: 1px solid var(--surface-2, #F2EFE8);
    font-size: 0.78rem;
}
.qv-spec-row:last-child { border-bottom: none; }
.qv-spec-label { color: var(--ink-3, #9C9589); font-weight: 500; }
.qv-spec-val   { color: var(--ink, #1A1714); font-weight: 600; }

.qv-bar-label {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--grey);
    width: 88px;
    flex-shrink: 0;
    text-transform: uppercase;
    letter-spacing: 0.07em;
}

.qv-bar {
    display: flex;
    gap: 4px;
    flex: 1;
}

.bar-seg {
    flex: 1;
    height: 5px;
    background: var(--cream-mid);
    border-radius: 3px;
    transition: background 0.32s ease;
}

.bar-seg--on {
    background: var(--red);
}

.qv-specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 18px;
}

.qv-spec-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.qv-spec-key {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--grey);
}

.qv-spec-val {
    font-size: 0.84rem;
    color: var(--slate);
    font-weight: 500;
}

.qv-rooms {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.qv-room {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 50px;
    font-family: var(--font-body);
    font-size: 0.74rem;
    font-weight: 500;
    border: 1.5px solid var(--cream-mid);
    background: var(--cream);
    color: #C2C6CC;
    transition: all var(--transition);
}

.qv-room i { font-size: 0.75rem; }

.qv-room--on {
    background: rgba(222, 56, 72, 0.07);
    border-color: rgba(222, 56, 72, 0.28);
    color: var(--red);
}

.qv-colours {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
}

.qv-colour {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--slate);
    background: var(--cream);
    border: 1px solid var(--cream-mid);
    padding: 4px 11px;
    border-radius: 50px;
}

.qv-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: auto;
    padding-top: 6px;
}

.qv-enquire {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 12px 16px;
    background: var(--red);
    color: var(--white);
    border: none;
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    letter-spacing: 0.02em;
    transition:
        background var(--transition),
        transform var(--transition),
        box-shadow var(--transition);
}

.qv-enquire:hover {
    background: var(--red-dark);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(222,56,72,0.3);
}

.qv-pdf-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 12px 16px;
    background: var(--navy, #1B3A5C);
    color: #fff;
    border: none;
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    letter-spacing: 0.02em;
    opacity: 1;
    transition: background var(--transition), opacity var(--transition), transform var(--transition);
}
.qv-pdf-btn:hover:not(:disabled) {
    background: #142d48;
    transform: translateY(-1px);
}
.qv-pdf-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    transform: none;
}

.qv-discount-wrap {
    margin-top: 8px;
    border: 1.5px dashed var(--red, #E03040);
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
}
.qv-discount-top {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: #FFF5F5;
    flex-wrap: wrap;
}
.qv-discount-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--red, #E03040);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    border-radius: 50px;
    flex-shrink: 0;
}
.qv-discount-label {
    font-size: 0.76rem;
    color: var(--ink-2, #5C574F);
    flex: 1;
}
.qv-discount-price {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--red, #E03040);
    letter-spacing: -0.01em;
}
.qv-discount-row {
    display: flex;
    align-items: stretch;
    border-top: 1.5px solid #ffd6d6;
}
.qv-discount-input {
    flex: 1;
    min-width: 0;
    padding: 11px 12px;
    border: none;
    font-family: var(--font-body);
    font-size: 0.83rem;
    color: var(--ink);
    outline: none;
    background: #fff;
}
.qv-discount-input::placeholder { color: var(--ink-3, #9C9589); }
.qv-discount-send {
    padding: 0 20px;
    background: var(--red, #E03040);
    color: #fff;
    border: none;
    border-left: 1.5px solid #ffd6d6;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    letter-spacing: 0.02em;
    transition: background 0.15s;
}
.qv-discount-send:hover { background: #c02030; }
.qv-discount-send:disabled { opacity: 0.6; cursor: default; }
.qv-discount-msg {
    font-size: 0.76rem;
    text-align: center;
    padding: 8px 14px;
    background: #FFF5F5;
    border-top: 1px solid #ffd6d6;
    color: var(--ink-2);
}

.qv-sample {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    background: transparent;
    color: var(--slate);
    border: 1.5px solid var(--grey-light);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition);
}

.qv-sample:hover {
    border-color: var(--slate);
    background: var(--cream);
}

.qv-note {
    font-size: 0.7rem;
    color: var(--grey);
    text-align: center;
    line-height: 1.55;
}

#cat-toast {
    position: fixed;
    bottom: 28px;
    left: 50%;
    z-index: 3000;
    transform: translateX(-50%) translateY(16px);
    background: var(--slate);
    color: var(--white);
    font-family: var(--font-body);
    font-size: 0.84rem;
    font-weight: 500;
    padding: 11px 22px;
    border-radius: 50px;
    box-shadow: 0 8px 28px rgba(0,0,0,0.22);
    opacity: 0;
    pointer-events: none;
    transition:
        opacity   0.28s ease,
        transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 9px;
}

#cat-toast.is-visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
}

#cat-toast i { color: #4DB88E; }

@media (max-width: 960px) {
    #cat-overlay { padding: 4vh 3vw; }
    #cat-panel   { max-height: 90vh; }

    

#cat-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }

    

    #cat-price-filters { flex-wrap: wrap; }

    .qv-inner          { grid-template-columns: 1fr; min-height: auto; }
    .qv-image-wrap     { height: 260px; border-radius: 14px 14px 0 0; }
    .qv-content        { padding: 24px 26px; }
    .qv-specs          { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 640px) {
    .cat-header-top { padding: 16px 18px 12px; }
    .cat-title-group {
        position: static;
        transform: none;
        text-align: left;
        max-width: 100%;
    }
    .cat-header-left {
        flex: 1;
        min-width: 0;
    }
    #cat-title      { font-size: 1.22rem; }
    .cat-filters    { padding: 0 18px 12px; }

    .cat-header-right { display: none; } 

    #cat-body  { padding: 14px; }
    #cat-grid  { grid-template-columns: 1fr 1fr; gap: 10px; }

    .cat-card-img-wrap { height: 144px; }
    .cat-card-body     { padding: 12px 13px 14px; gap: 7px; }
    .cat-card-name     { font-size: 1.04rem; }
    .cat-card-specs    { display: none; } 

    .room-pill {
        width: 24px;
        height: 24px;
        font-size: 0.62rem;
    }

    #cat-qv {
        padding: 0;
        align-items: flex-end;
        border-radius: 0;
    }

    #cat-qv-panel {
        border-radius: 20px 20px 0 0;
        max-height: 92vh;
        max-width: 100%;

    }
    #cat-qv-panel .qv-image-col {
        position: relative;
        top: auto;
        padding: 12px 12px 0;
        background: #fff;
    }
    #cat-qv-panel .qv-main-img-wrap {
        border-radius: 12px;
    }
    .qv-close {
        position: absolute;
        top: 12px;
        right: 12px;
        z-index: 100;
    }

    .qv-image-wrap     { height: 220px; border-radius: 20px 20px 0 0; }
    .qv-content        { padding: 18px 18px 28px; gap: 12px; }
    .qv-actions        { grid-template-columns: 1fr; }
    .qv-specs          { grid-template-columns: 1fr 1fr; }
}

@media (prefers-reduced-motion: reduce) {
    #cat-panel,
    #cat-qv-panel,
    #cat-qv,
    .cat-card,
    .cat-backdrop,
    #cat-toast {
        transition-duration: 0.01ms !important;
        animation-duration:  0.01ms !important;
    }
}

.cat-sort-dropdown {
    position: relative;
    cursor: pointer;
    outline: none;
    min-width: 180px;
}

.cat-sort-selected {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 14px;
    background: var(--cream);
    border: 1.5px solid var(--cream-mid);
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--slate);
    font-family: var(--font-body);
    transition: border-color 0.2s, background 0.2s;
    user-select: none;
    white-space: nowrap;
}

.cat-sort-dropdown:focus .cat-sort-selected,
.cat-sort-dropdown.is-open .cat-sort-selected {
    border-color: var(--red);
    background: var(--white);
}

.cat-sort-arrow {
    color: var(--grey);
    flex-shrink: 0;
    transition: transform 0.2s ease, color 0.2s ease;
}

.cat-sort-dropdown.is-open .cat-sort-arrow {
    transform: rotate(180deg);
    color: var(--red);
}

.cat-sort-list {
    display: none;
    position: absolute;
    right: 0;
    min-width: 100%;
    background: var(--white);
    border: 1.5px solid var(--cream-mid);
    border-radius: var(--radius-sm);
    overflow: hidden;
    list-style: none;
    z-index: 200;
    box-shadow: var(--shadow-card);
}

.cat-sort-dropdown.is-open .cat-sort-list {
    display: block;
}

.cat-sort-item {
    padding: 10px 14px;
    font-size: 0.85rem;
    color: var(--slate);
    font-family: var(--font-body);
    cursor: pointer;
    transition: background 0.15s ease;
    border-bottom: 1px solid var(--cream-mid);
    white-space: nowrap;
}

.cat-sort-item:last-child {
    border-bottom: none;
}

.cat-sort-item:hover {
    background: var(--cream);
}

.cat-sort-item.is-selected {
    background: var(--cream);
    color: var(--red);
    font-weight: 600;
}

@media (max-width: 640px) {
    .cat-header-top {
        padding-top: max(20px, env(safe-area-inset-top, 20px));
    }
}

