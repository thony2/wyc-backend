}

.contact-methods {
    display: flex;
    flex-direction: column;
    gap: 16px;
}
.contact-method {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    background: var(--white);
    border: 1px solid var(--grey-light);
    border-radius: var(--radius-md);
    transition: background var(--transition), border-color var(--transition);
}
.contact-method:hover {
    background: var(--cream-mid);
    border-color: #d0d3d6;
}
.method-icon {
    width: 42px;
    height: 42px;
    background: rgba(222,56,72,0.15);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--red);
    font-size: 1rem;
    flex-shrink: 0;
}
.method-text {
    display: flex;
    flex-direction: column;
}
.method-text span {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--grey);
}
.method-text strong {
    font-size: 0.95rem;
    color: var(--ink);
    font-weight: 500;
    margin-top: 2px;
}

/* Contact Form */
.contact-form-wrap {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: 44px 40px;
    box-shadow: var(--shadow-lift);
}

.form-group {
    margin-bottom: 20px;
}
.form-group label {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--grey);
