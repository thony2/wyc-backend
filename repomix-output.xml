<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;font-family:'Inter',sans-serif}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

#login-screen{min-height:100vh;display:flex;align-items:center;justify-content:center;background:#1B3A5C}
.login-box{width:100%;max-width:400px;padding:48px 40px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:12px;text-align:center}
.login-logo{font-family:'Cormorant Garamond',serif;font-size:1.7rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#F0EEE4}
.login-sub{font-size:.75rem;color:#6B7280;letter-spacing:.08em;text-transform:uppercase;margin:14px 0 26px}
.login-field{margin-bottom:14px;text-align:left}
.login-label{display:block;font-size:.68rem;font-weight:600;text-transform:uppercase;letter-spacing:.07em;color:#6B7280;margin-bottom:6px}
.login-input{width:100%;padding:13px 16px;background:#2E2F36;border:1px solid rgba(255,255,255,.07);border-radius:6px;color:#E8E9EF;font-size:.9rem;outline:none;transition:border-color .2s;font-family:'Inter',sans-serif}
.login-input:focus{border-color:#DE3848}
.login-input::placeholder{color:#6B7280}
.login-btn{width:100%;margin-top:10px;padding:14px;background:#DE3848;border:none;border-radius:6px;color:white;font-size:.9rem;font-weight:600;cursor:pointer;font-family:'Inter',sans-serif;transition:background .2s}
.login-btn:hover{background:#B92E3C}
.login-error{margin-top:14px;font-size:.82rem;color:#DE3848;display:none}

#app{display:none;min-height:100vh;background:#F8F6F1}

/* ── Sidebar ── */
.sidebar{position:fixed;left:0;top:0;bottom:0;width:240px;background:#23242B;border-right:1px solid rgba(255,255,255,.07);display:flex;flex-direction:column;z-index:100}
.sidebar-logo{padding:26px 22px 18px;border-bottom:1px solid rgba(255,255,255,.07)}
.sidebar-logo-text{font-family:'Cormorant Garamond',serif;font-size:1.1rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#F0EEE4}
.sidebar-logo-sub{font-size:.68rem;color:#6B7280;letter-spacing:.06em;text-transform:uppercase;margin-top:3px}
.sidebar-nav{padding:12px 10px;flex:1;overflow-y:auto}
.nav-group-label{font-size:.63rem;color:#6B7280;letter-spacing:.1em;text-transform:uppercase;padding:12px 12px 5px;margin-top:4px}
.nav-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:6px;font-size:.85rem;color:#A2A8B0;cursor:pointer;transition:all .15s;margin-bottom:2px;border:none;background:none;width:100%;text-align:left;font-family:'Inter',sans-serif}
.nav-item:hover{background:#3A3B44;color:#E8E9EF}
.nav-item.active{background:rgba(222,56,72,.08);color:#DE3848}
.nav-item i{width:16px;text-align:center;flex-shrink:0;font-size:.85rem}
.nav-badge{margin-left:auto;background:#DE3848;color:white;font-size:.63rem;font-weight:700;padding:2px 7px;border-radius:10px;min-width:20px;text-align:center}
.sidebar-footer{padding:14px 10px;border-top:1px solid rgba(255,255,255,.07)}
.sidebar-user{font-size:.73rem;color:rgba(255,255,255,.3);margin-bottom:10px;padding:0 12px}
.sidebar-user strong{color:rgba(255,255,255,.6);display:block;margin-bottom:1px;font-size:.8rem}
.logout-btn{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:6px;font-size:.84rem;color:#6B7280;cursor:pointer;width:100%;border:none;background:none;font-family:'Inter',sans-serif;transition:color .15s}
.logout-btn:hover{color:#DE3848}

#main-content{margin-left:240px;min-height:100vh}

#toast{position:fixed;bottom:26px;right:26px;background:#1B3A5C;border:1px solid rgba(27,58,92,.1);border-radius:8px;padding:12px 18px;font-size:.84rem;color:#FFFFFF;display:flex;align-items:center;gap:10px;transform:translateY(80px);opacity:0;transition:all .3s;z-index:9000;box-shadow:0 8px 24px rgba(0,0,0,.5);pointer-events:none}
#toast.show{transform:translateY(0);opacity:1}
#toast.success{border-left:3px solid #27AE60}
#toast.success i{color:#27AE60}
#toast.error{border-left:3px solid #DE3848}
#toast.error i{color:#DE3848}


.sidebar-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:99;opacity:0;transition:opacity .25s;pointer-events:none}
.sidebar-overlay.open{opacity:1;pointer-events:all}
.mobile-topbar{display:none;position:fixed;top:0;left:0;right:0;height:56px;background:#23242B;border-bottom:1px solid rgba(255,255,255,.07);align-items:center;padding:0 16px;gap:12px;z-index:101}
.mobile-topbar-logo{height:28px;width:auto;object-fit:contain}
.mobile-topbar-title{font-family:"Cormorant Garamond",serif;font-size:1rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#F0EEE4;flex:1}
.hamburger-btn{background:none;border:none;color:#A2A8B0;font-size:1.1rem;cursor:pointer;padding:6px;display:flex;align-items:center;justify-content:center;transition:color .15s}
.hamburger-btn:hover{color:#F0EEE4}
@media(max-width:900px){
  .mobile-topbar{display:flex}
  .sidebar{transform:translateX(-100%);transition:transform .25s cubic-bezier(.4,0,.2,1);z-index:200;width:240px}
  .sidebar.open{transform:translateX(0)}
  .sidebar-overlay{display:block;pointer-events:none}
  #main-content{margin-left:0;padding-top:56px}
  .sidebar-logo img.logo-desktop{display:none}
  .sidebar-logo img.logo-mobile{display:block}
}
@media(min-width:901px){
  .sidebar-logo img.logo-mobile{display:none}
  .sidebar-logo img.logo-desktop{display:block}
}

