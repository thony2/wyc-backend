}
.btn-submit:hover {
    background: var(--red-dark);
    transform: translateY(-1px);
}
.btn-submit i { transition: transform var(--transition); }
.btn-submit:hover i { transform: translateX(4px); }

.form-note {
    text-align: center;
    font-size: 0.75rem;
    color: var(--grey);
    margin-top: 12px;
}

footer {
