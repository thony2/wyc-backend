async function loadCalendar() {
  const grid = document.getElementById('cal-grid');
  grid.style.opacity = '0';
  try {
    const r = await fetch(`${LEADS_API}/api/admin/calendar?month=${calYear}-${String(calMonth+1).padStart(2,'0')}`, {
      headers: {'Authorization': `Bearer ${TOKEN}`}
    });
    const d = await r.json();
    if (d.success) {
      calBookings    = d.data.bookings    || [];
      calUnscheduled = d.data.unscheduled || [];
    }
  } catch(e) { calBookings = []; calUnscheduled = []; }
  renderCalendar();
  renderUnscheduled();
  requestAnimationFrame(() => { grid.style.opacity = '1'; });
}

function renderCalendar() {
  const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  document.getElementById('cal-month-label').textContent = `${months[calMonth]} ${calYear}`;
  const grid = document.getElementById('cal-grid');
  grid.querySelectorAll('.cal-day').forEach(d=>d.remove());
  const today = new Date();
  const first = new Date(calYear, calMonth, 1);
  let startDay = first.getDay() - 1;
  if (startDay < 0) startDay = 6;
  const daysInMonth = new Date(calYear, calMonth+1, 0).getDate();
  const daysInPrev  = new Date(calYear, calMonth, 0).getDate();

  const bookingsByDate = {};
  calBookings.forEach(b => {
    const d = b.booking_date;
    if (!bookingsByDate[d]) bookingsByDate[d] = [];
    bookingsByDate[d].push(b);
  });
  for (let i = startDay - 1; i >= 0; i--) {
    const day = document.createElement('div');
    day.className = 'cal-day other-month';
    day.innerHTML = `<div class="cal-day-num">${daysInPrev - i}</div>`;
    grid.appendChild(day);
  }
  for (let d = 1; d <= daysInMonth; d++) {
    const dateStr = `${calYear}-${String(calMonth+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const isToday = d === today.getDate() && calMonth === today.getMonth() && calYear === today.getFullYear();
    const events  = bookingsByDate[dateStr] || [];
    const day = document.createElement('div');
    day.className = `cal-day${isToday?' today':''}${selectedDay===dateStr?' selected':''}`;
    day.onclick   = (e) => { e.stopPropagation(); selectCalDay(dateStr, events, day); };
    const numEl   = document.createElement('div');
    numEl.className   = 'cal-day-num';
    numEl.textContent = d;
    day.appendChild(numEl);
    const show = events.slice(0,3);
    show.forEach(ev => {
      const e = document.createElement('div');
      e.className = `cal-event ${ev.booking_type||ev.status||'new'}`;
      e.textContent = ev.name || 'Lead';
      day.appendChild(e);
    });
    if (events.length > 3) {
      const m = document.createElement('div');
      m.className   = 'cal-more';
      m.textContent = `+${events.length - 3} more`;
      day.appendChild(m);
    }
    grid.appendChild(day);
  }
  const total = startDay + daysInMonth;
  const rem   = 7 - (total % 7);
  if (rem < 7) {
    for (let i = 1; i <= rem; i++) {
      const day = document.createElement('div');
      day.className = 'cal-day other-month';
      day.innerHTML = `<div class="cal-day-num">${i}</div>`;
      grid.appendChild(day);
    }
  }
}

