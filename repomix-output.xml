.form-dropdown {
    position: relative;
    width: 100%;
    cursor: pointer;
    outline: none;
}

.form-dropdown-selected {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 12px 14px;
    background: var(--cream);
    border: 1.5px solid var(--cream-mid);
    border-radius: var(--radius-sm);
    font-size: 0.92rem;
    color: var(--ink);
    font-family: var(--font-body);
    transition: border-color var(--transition), background var(--transition);
    user-select: none;
}

.form-dropdown:focus .form-dropdown-selected,
.form-dropdown.is-open .form-dropdown-selected {
    outline: none;
    border-color: var(--red);
    background: var(--white);
}

.form-dropdown-arrow {
    color: var(--grey);
    flex-shrink: 0;
    transition: transform 0.2s ease, color 0.2s ease;
}

.form-dropdown.is-open .form-dropdown-arrow {
    transform: rotate(180deg);
    color: var(--red);
}

.form-dropdown-list {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    background: var(--white);
    border: 1.5px solid var(--cream-mid);
    border-radius: var(--radius-sm);
    overflow: hidden;
    list-style: none;
    z-index: 100;
    box-shadow: var(--shadow-card);
}

.form-dropdown.is-open .form-dropdown-list {
    display: block;
}

.form-dropdown-item {
    padding: 12px 14px;
    font-size: 0.92rem;
    color: var(--ink);
    font-family: var(--font-body);
    cursor: pointer;
    transition: background 0.15s ease;
    border-bottom: 1px solid var(--cream-mid);
}

.form-dropdown-item:last-child {
    border-bottom: none;
}

.form-dropdown-item:hover {
    background: var(--cream);
}

.form-dropdown-item.is-selected {
    background: var(--cream);
    color: var(--red);
    font-weight: 600;
}



@media (max-width: 640px) {
    .calc-switcher-wrap {
        position: static;
        height: auto;
        margin-bottom: 20px;
    }
    .calc-mode-panel {
        position: static;
        opacity: 1;
        pointer-events: none;
        display: none;
    }
    .calc-mode-panel.is-active {
        display: block;
        pointer-events: auto;
    }
    .input-row {
        grid-template-columns: 1fr 1fr;
    }
}

/* ── Horizontal overflow fix ── */
html, body { overflow-x: clip; }
.flooring-grid { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
.insta-grid    { grid-template-columns: repeat(5, minmax(0, 1fr)); }

html { overscroll-behavior: none; }


/* ── Catalogue nudge in calculator section ── */
.calc-catalogue-nudge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    border: 1.5px solid #C49A3C;
    border-radius: 10px;
    padding: 12px 18px;
    margin-top: 12px;
    font-size: .85rem;
    color: #5C574F;
    max-width: 600px;
}
.calc-catalogue-nudge i {
    color: #C49A3C;
    font-size: 1rem;
    flex-shrink: 0;
}
.calc-catalogue-nudge a {
    color: #1B3A5C;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
}
.calc-catalogue-nudge a:hover { color: #C49A3C; }
</file>

