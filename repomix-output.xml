        /* 3. The Breadcrumb/Link (Functional UI) */
        .ui-link {
            display: flex;
            align-items: center;
            gap: 4px;
            text-decoration: none;
            color: var(--text);
            font-size: 14px;
        }
        .ui-link i { font-size: 16px; color: var(--text); }

        /* 4. The Selection Tab (Contextual/Rooms) */
        .tab-pill {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            background: var(--white);
            border: 1px solid var(--border);
            padding: 12px;
            border-radius: var(--r-md);
            width: 100px;
            cursor: pointer;
        }
        .tab-pill i { color: var(--muted); font-size: var(--icon-sm); }
        .tab-pill span { font-size: 12px; color: var(--muted); font-weight: 500; }

        /* 5. Utility Row (Measurement) */
        .utility-box {
            display: flex;
