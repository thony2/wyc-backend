# ============================================================
# West Yorkshire Carpets — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── APPLICATION ─────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# The exact origin of your frontend (no trailing slash).
# For local dev this is likely http://localhost:5500 (Live Server)
# For production set to your actual domain
ALLOWED_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# ── DATABASE ────────────────────────────────────────────────
# SQLite is used by default (great for local dev).
# Set DB_TYPE=postgres to switch to PostgreSQL.
DB_TYPE=sqlite

# SQLite: path to the database file (relative to project root)
SQLITE_PATH=./data/wyc_leads.db

# PostgreSQL: only required if DB_TYPE=postgres
# For local dev use the Railway PUBLIC host (hopper.proxy.rlwy.net)
# For production Railway uses the PRIVATE host (postgres.railway.internal)
PGHOST=localhost
PGPORT=5432
PGDATABASE=railway
PGUSER=postgres
PGPASSWORD=CHANGE_ME_your_postgres_password

# ── SECURITY ────────────────────────────────────────────────
# Random 32+ character string.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_generate_with_node

# ── JWT (Admin Panel Login) ──────────────────────────────────
# Required — the server will EXIT on startup if this is missing.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_with_node

# ── ADMIN ────────────────────────────────────────────────────
# Simple bearer token to protect legacy admin API endpoints.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=CHANGE_ME_generate_with_node

# Default password used by scripts/reset-admin-password.js
# Run: npm run admin:reset-password after changing this value
# Minimum 12 characters, mix of uppercase, lowercase, numbers and symbols
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_strong_password_min_12_chars

# ── EMAIL NOTIFICATIONS ─────────────────────────────────────
# Set MAIL_ENABLED=true to send emails on new leads.
MAIL_ENABLED=false

# SMTP settings — works with Gmail, Brevo, Mailgun, AWS SES, etc.
# For Gmail: enable 2FA and create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password_here

# Where notification emails are sent FROM and TO
MAIL_FROM="West Yorkshire Carpets <noreply@westyorkshirecarpets.com>"
MAIL_TO=admin@westyorkshirecarpets.com

# ── CLOUDINARY (Product Image Uploads) ───────────────────────
# Required for the catalogue importer to upload product images.
# Sign up at https://cloudinary.com — all three values are on your dashboard.
CLOUDINARY_CLOUD_NAME=CHANGE_ME_your_cloud_name
CLOUDINARY_API_KEY=CHANGE_ME_your_api_key
CLOUDINARY_API_SECRET=CHANGE_ME_your_api_secret

# ── SITE ─────────────────────────────────────────────────────
# Used for SEO product pages, canonical URLs, and sitemap generation.
# No trailing slash.
SITE_URL=https://www.westyorkshirecarpets.com

# ── RATE LIMITING ───────────────────────────────────────────
# Max requests per IP per window
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=900000

# ── LOGGING ─────────────────────────────────────────────────
# 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info
