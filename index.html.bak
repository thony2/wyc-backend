    <div class="mobile-cta" id="mobile-cta">
        <a href="tel:07449188303" class="mcta-btn mcta-phone">
            <i class="fa-solid fa-phone"></i>
            <span>Call Now</span>
        </a>
        <a href="#quote" class="mcta-btn mcta-quote">
            <i class="fa-solid fa-calculator"></i>
            <span>Get Quote</span>
        </a>
    </div>

    <script src="./js/script.js"></script>
    <script src="./js/form-handler.js"></script>
    <script src="./js/catalogue.js"></script>
    <div id="cat-overlay"
         role="dialog"
         aria-modal="true"
         aria-labelledby="cat-title"
         aria-hidden="true"
         hidden>

        <div class="cat-backdrop" id="cat-backdrop" aria-hidden="true"></div>

        <div id="cat-panel" role="document">

            <div class="cat-header" role="banner">

                <div class="cat-header-top">
                    <div class="cat-header-left">
                        <button id="cat-close"
                                type="button"
                                aria-label="Close catalogue">
                            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                        </button>
                        <div class="cat-title-group">
                            <span id="cat-title">Our Range</span>
                            <span id="cat-desc">Browse our complete collection of premium flooring</span>
                        </div>
                    </div>
                    <div class="cat-header-right">
    <span id="cat-count" aria-live="polite" aria-atomic="true"></span>

    <select id="cat-sort" aria-hidden="true" tabindex="-1" style="display:none;">
        <option value="default">Featured</option>
        <option value="price-asc">Price: Low to High</option>
        <option value="price-desc">Price: High to Low</option>
        <option value="name">Name: A–Z</option>
    </select>

    <div class="cat-sort-dropdown" id="cat-sort-dropdown" role="combobox" aria-expanded="false" aria-label="Sort products" tabindex="0">
        <div class="cat-sort-selected">
            <span id="cat-sort-label">Featured</span>
            <svg class="cat-sort-arrow" width="12" height="7" viewBox="0 0 12 7" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
        <ul class="cat-sort-list" role="listbox">
            <li class="cat-sort-item is-selected" role="option" data-value="default" aria-selected="true">Featured</li>
            <li class="cat-sort-item" role="option" data-value="price-asc" aria-selected="false">Price: Low to High</li>
            <li class="cat-sort-item" role="option" data-value="price-desc" aria-selected="false">Price: High to Low</li>
            <li class="cat-sort-item" role="option" data-value="name" aria-selected="false">Name: A–Z</li>
        </ul>
    </div>

</div>
                </div>

                <div class="cat-filters" role="toolbar" aria-label="Filter products">

                    <div id="cat-tabs" role="tablist" aria-label="Filter by category">
                        <button class="cat-tab is-active" data-cat="all"      role="tab" aria-selected="true">All</button>
                        <button class="cat-tab"           data-cat="carpets"  role="tab" aria-selected="false">Carpets</button>
                        <button class="cat-tab"           data-cat="vinyl"    role="tab" aria-selected="false">Vinyl</button>
                        <button class="cat-tab"           data-cat="laminate" role="tab" aria-selected="false">Laminate</button>
                        <button class="cat-tab"           data-cat="wood"     role="tab" aria-selected="false">Wood</button>
                        <button class="cat-tab cat-tab--deals" data-cat="deals" role="tab" aria-selected="false">Deals 🔥</button>
                    </div>

                    <div id="cat-price-filters" aria-label="Filter by price">
                        <button class="cat-price-btn is-active" data-price="all"     type="button">All Prices</button>
                        <button class="cat-price-btn"           data-price="budget"  type="button">Budget &lt;£20</button>
                        <button class="cat-price-btn"           data-price="mid"     type="button">£20–£40</button>
                        <button class="cat-price-btn"           data-price="premium" type="button">Premium £40+</button>
                    </div>

                </div>
            </div>

        <div id="cat-body" role="main">
    
        <div id="cat-grid"
                role="list"
                aria-label="Flooring products"
                aria-live="polite"
                aria-atomic="false">
        </div>

        <div id="cat-empty" hidden aria-live="assertive">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <p>No products match your current filters.</p>
                <button id="cat-reset-btn" class="btn-primary" type="button">
                    Clear All Filters
                 </button>
                </div>
            </div>
        </div>

        <div id="cat-qv"
             role="dialog"
             aria-modal="true"
             aria-label="Product quick view"
             hidden>
            <div id="cat-qv-panel">
            </div>
        </div>
    </div>

    <div id="cat-toast" role="status" aria-live="polite" aria-atomic="true"></div>
    <div id="lightbox-overlay" hidden aria-modal="true" role="dialog" aria-label="Image viewer">
        <button id="lightbox-close" aria-label="Close image viewer">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
        <button id="lightbox-prev" class="lightbox-nav" aria-label="Previous image">
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
        </button>
        <button id="lightbox-next" class="lightbox-nav" aria-label="Next image">
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
        </button>
        <div class="lightbox-inner">
            <img id="lightbox-img" src="" alt="">
        <div class="lightbox-footer">
                <span id="lightbox-caption"></span>
                <span id="lightbox-counter"></span>
        </div>
        </div>
    </div>

</body>
</html>
